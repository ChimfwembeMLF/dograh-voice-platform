# Traefik file-provider routing for Dograh (Compose fallback)
# Generated by scripts/generate-voice-traefik-config.sh — do not edit by hand.
# Replace PUBLIC_HOST, API_UPSTREAM, UI_UPSTREAM before use if not using the generator.

http:
  routers:
    voice-dograh-api:
      rule: "Host(`PUBLIC_HOST`) && PathPrefix(`/api/v1`)"
      service: voice-dograh-api
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
      priority: 10

    voice-dograh-ui:
      rule: "Host(`PUBLIC_HOST`)"
      service: voice-dograh-ui
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
      priority: 1

    voice-dograh-http-redirect:
      rule: "Host(`PUBLIC_HOST`)"
      entryPoints:
        - web
      middlewares:
        - redirect-to-https
      service: voice-dograh-ui
      priority: 1

  services:
    voice-dograh-api:
      loadBalancer:
        servers:
          - url: "http://API_UPSTREAM:8000"
        passHostHeader: true

    voice-dograh-ui:
      loadBalancer:
        servers:
          - url: "http://UI_UPSTREAM:3010"
        passHostHeader: true
