FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir piper-tts fastapi uvicorn pydantic

RUN mkdir -p /data \
    && python3 -m piper.download_voices en_US-lessac-medium --download-dir /data

COPY piper-server.py .

ENV PORT=5000
ENV PIPER_VOICE_DIR=/data
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://127.0.0.1:5000/health || exit 1

CMD ["uvicorn", "piper-server:app", "--host", "0.0.0.0", "--port", "5000"]
