# =============================================================================
# Paste into Dokploy → Compose service → Environment tab
# NEVER commit dograh.env with real secrets — use this file as template only
#
# Generate secrets:
#   openssl rand -base64 32   # OSS_JWT_SECRET, POSTGRES_PASSWORD
#   openssl rand -hex 32      # TURN_SECRET, ARI_APP_PASSWORD
# =============================================================================

# --- Traefik / public URL ---
PUBLIC_HOST=voice.tekreminnovations.com
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Postgres (bundled pgvector in compose) ---
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=dograh-db
# Optional external pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@host:5432/dograh-db

# --- External Redis (must be on dokploy-network) ---
REDIS_URL=redis://default:CHANGE_ME_REDIS_PASSWORD@voiceagentplatform-ivr-7yzk3e:6379

# --- MinIO S3 ---
S3_ENDPOINT_URL=https://s3.tekreminnovations.com
S3_BUCKET=mako
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_SIGNATURE_VERSION=s3v4
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=change-me-strong-s3-password

# --- WebRTC / coturn ---
TURN_HOST=voice.tekreminnovations.com
TURN_SECRET=change-me-turn-secret
FORCE_TURN_RELAY=false

# --- Dograh app ---
OSS_JWT_SECRET=change-me-jwt-secret
ENABLE_SIGNUP=true
ENABLE_TELEMETRY=false
LOG_LEVEL=INFO
BACKEND_URL=http://api:8000
REGISTRY=dograhai
DOGRAH_VERSION=latest

# --- Voice AI backends ---
WHISPER_MODEL=small.en
PIPER_MODEL=en_US-lessac-medium
WHISPER_URL=http://whisper:9000
PIPER_URL=http://piper:5000

# --- Asterisk ARI (Server A → Dograh) ---
ASTERISK_HOST=YOUR_TELEPHONY_SERVER_IP
ASTERISK_ARI_PORT=8088
ARI_APP_NAME=dograh
ARI_APP_PASSWORD=change-me-ari-password
DOGRAH_ARI_WS_URI=wss://voice.tekreminnovations.com/api/v1/telephony/ws/ari
DOGRAH_INBOUND_EXTENSION=8000

# --- Dograh Models (configure in UI) ---
# LLM:  OpenAI  https://ai.tekreminnovations.com/v1  llama3.2
# STT:  OpenAI  http://whisper:9000/v1               whisper-1
# TTS:  OpenAI  http://piper:5000/v1                tts-1

# --- Optional: sip-connector (COMPOSE_PROFILES=sip-connector) ---
OLLAMA_URL=https://ai.tekreminnovations.com/api/generate
OLLAMA_MODEL=llama3.2
SIP_HOST=YOUR_TELEPHONY_SERVER_IP
SIP_PORT=5060
SIP_EXTENSION=9000
SIP_SECRET=change-me-sip-password
SIP_LOCAL_IP=
SIP_CONNECTOR_PORT=8080
SIP_REGISTER_INTERVAL=300
HTTP_TIMEOUT=120
SYSTEM_PROMPT=You are a helpful voice assistant on a phone call. Keep replies concise and conversational.

# --- Optional: monitoring (COMPOSE_PROFILES=monitoring) ---
PROMETHEUS_PORT=9090
